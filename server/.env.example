PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hotelpro
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Frontend URL(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# ---- Email notifications (optional) ----
# If nothing is set, emails are only printed in the server console and the app still works.
# Option A (use this when deployed on Render): Brevo API. MAIL_FROM must be a verified sender in Brevo.
BREVO_API_KEY=
MAIL_FROM=
# Option B (works locally): any SMTP server, e.g. Gmail with an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Room photo upload (optional) ----
# Without Cloudinary, photos are saved in server/uploads (fine locally, lost on free hosting restarts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
